# Solace Broker Connection (SMF Binary Transport)
SOLACE_HOST=tcp://localhost:55555
SOLACE_VPN=default
SOLACE_USERNAME=admin
SOLACE_PASSWORD=admin
SOLACE_QUEUE_NAME=flink.feature.processor

# Redis Feature Store
REDIS_URL=redis://localhost:6379/0

# Historical S3 / MinIO Parquet Sink
S3_BUCKET=aircraft-engine-data
MINIO_ENDPOINT=http://localhost:9001
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# Streaming Consumer Tuning
FLUSH_EVERY=500
