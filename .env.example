# AWS S3 Data Lake Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=bucket_name

# DagsHub & MLflow Experiment Tracking
DAGSHUB_TOKEN=your_dagshub_token
DAGSHUB_USERNAME=your_dagshub_username
MLFLOW_TRACKING_URI=https://dagshub.com/your_dagshub_username/repo-name.mlflow
DAGSHUB_REPO_NAME=repo-name

# Redis Feature Store & Stream Transport
REDIS_URL=redis://localhost:6379/0

# Solace PubSub+ (Optional Event Broker)
# SOLACE_HOST=tcp://localhost:55555
# SOLACE_VPN=default
# SOLACE_USERNAME=admin
# SOLACE_PASSWORD=admin
# SOLACE_QUEUE_NAME=flink.feature.processor
